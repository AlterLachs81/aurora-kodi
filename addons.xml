<?xml version='1.0' encoding='utf-8'?>
<addons>
  <addon id="plugin.video.netflix.aurora" name="Aurora for Netflix" version="0.3.0" provider-name="AlterLachs81">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
      <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="de_DE">Aurora: Netflix-Navigation für Kodi</summary>
      <description lang="de_DE">Eigenständige Kodi-Navigation mit Kategorien, Suche, Aurora-Favoriten und Verlauf. Für Netflix-Katalog und Wiedergabe wird aktuell das installierte Netflix-Add-on als Brücke verwendet.</description>
      <platform>all</platform>
      <license>MIT</license>
    </extension>
    <zip url="https://raw.githubusercontent.com/AlterLachs81/aurora-kodi/main/addons/plugin.video.netflix.aurora/plugin.video.netflix.aurora-0.3.0.zip" />
  </addon>
  <addon id="repository.aurora" name="Aurora Add-on Repository" version="1.0.0" provider-name="AlterLachs81">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.addon.repository" name="Aurora Add-on Repository">
      <dir>
        <info>https://raw.githubusercontent.com/AlterLachs81/aurora-kodi/main/addons.xml</info>
        <checksum>https://raw.githubusercontent.com/AlterLachs81/aurora-kodi/main/addons.xml.md5</checksum>
        <datadir zip="true">https://raw.githubusercontent.com/AlterLachs81/aurora-kodi/main/addons/</datadir>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="de_DE">Aurora Repository</summary>
      <description lang="de_DE">Installiert und aktualisiert Aurora for Netflix über Kodi.</description>
      <platform>all</platform>
      <license>MIT</license>
    </extension>
    <zip url="https://raw.githubusercontent.com/AlterLachs81/aurora-kodi/main/addons/repository.aurora/repository.aurora-1.0.0.zip" />
  </addon>
</addons>
